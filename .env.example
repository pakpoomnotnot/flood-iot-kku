# Copy this file to .env and fill in the values. .env is ignored by git.
# Used by `npm run dev` and by docker compose (which reads .env automatically).

# Origin of the internal data server that hosts the telemetry, rain forecast,
# flood map and HMS result files under /transfer_data/. No trailing slash.
# Example: http://data-server.example:8080
DATA_SERVER_URL=

# MapTiler API key for the basemaps. Exposed to the browser and inlined at build
# time, so restrict it to your deployed origins in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Credentials for the /login page. Login is disabled if either value is empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
